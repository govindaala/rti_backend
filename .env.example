# रिपॉजिटरी पथ: rti_backend/.env.example
# यह केवल उदाहरण है; वास्तविक API keys या पासवर्ड यहाँ न डालें।
APP_NAME=RTI Intelligence Platform API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Supabase PostgreSQL connection string को केवल hosting Environment Variables में सेट करें।
# स्थानीय विकास में अपनी निजी .env फाइल में मान भरें; उसे GitHub पर commit न करें।
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5
