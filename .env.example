# रिपॉजिटरी पथ: rti_backend/.env.example
# केवल placeholders; वास्तविक secrets इस फाइल में कभी न रखें।
APP_NAME=RTI Intelligence Platform API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5
# Render/server environment में मजबूत random secret सेट करें; browser में न रखें।
ADMIN_API_TOKEN=
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_MAX_BYTES=12000000
CRAWLER_POLL_SECONDS=2
CRAWLER_IDLE_SECONDS=10
CRAWLER_LINKS_PER_PAGE=25
CRAWLER_MAX_PAGES_PER_SOURCE=250
CRAWLER_RECRAWL_HOURS=24
